{
  "name": "happiness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "sim": "node src/sim/cli.ts",
    "budget": "node src/sim/budget-cli.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "preact": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
